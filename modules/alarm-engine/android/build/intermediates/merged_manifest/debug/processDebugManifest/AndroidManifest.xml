<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.alarmengine" >

    <uses-sdk android:minSdkVersion="24" />

    <application>
        <receiver
            android:name="expo.modules.alarmengine.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="expo.modules.alarmengine.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name="expo.modules.alarmengine.AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name="expo.modules.alarmengine.AlarmRingActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:turnScreenOn="true" />
    </application>

</manifest>