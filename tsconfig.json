
{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "files": [],
  "include": [
    "App.ts",
    "App.tsx",
    "index.ts",
    "index.tsx",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "modules",
    "**/example/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
