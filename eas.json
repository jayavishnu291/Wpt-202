
{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
   "preview": {
  "distribution": "internal",
  "android": {
    "buildType": "apk"
  },
  "env": {
    "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
    "GRADLE_OPTS": "-Dorg.gradle.workers.max=2 -Dorg.gradle.parallel=false"
  }
},
    "production": {
      "autoIncrement": true
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
